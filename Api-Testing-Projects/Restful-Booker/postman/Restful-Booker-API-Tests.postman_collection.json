    {
      "name": "Booking",
      "item": [
        {
          "name": "CreateBooking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Booking ID is present\", function () {\r",
                  "    pm.expect(pm.response.json().bookingid).to.be.a('number');\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Booking Created successfully\", function () {\r",
                  "    pm.expect(pm.response.json().booking.firstname).to.eql(\"Jim\");\r",
                  "    pm.expect(pm.response.json().booking.lastname).to.eql(\"Brown\");\r",
                  "    pm.expect(pm.response.json().booking.totalprice).to.eql(111);\r",
                  "    pm.expect(pm.response.json().booking.depositpaid).to.eql(true);\r",
                  "    pm.expect(pm.response.json().booking.bookingdates.checkin).to.eql(\"2018-01-01\");\r",
                  "    pm.expect(pm.response.json().booking.bookingdates.checkout).to.eql(\"2019-01-01\");\r",
                  "    pm.expect(pm.response.json().booking.additionalneeds).to.eql(\"Breakfast\");\r",
                  "});\r",
                  "const bookingId = pm.response.json().bookingid;\r",
                  "pm.collectionVariables.set(\"bookingId\", bookingId);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstname\" : \"Jim\",\r\n    \"lastname\" : \"Brown\",\r\n    \"totalprice\" : 111,\r\n    \"depositpaid\" : true,\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"2018-01-01\",\r\n        \"checkout\" : \"2019-01-01\"\r\n    },\r\n    \"additionalneeds\" : \"Breakfast\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GetBookingId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response is an array of booking IDs\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.be.an('array');\r",
                  "    pm.expect(jsonData[0]).to.have.property('bookingid');\r",
                  "});\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking",
