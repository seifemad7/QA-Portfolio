        {
          "name": "GetBooking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "pm.test(\"Booking data matches\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.firstname).to.not.be.null;\r",
                  "    pm.expect(jsonData.lastname).to.not.be.null;\r",
                  "    pm.expect(jsonData.totalprice).to.be.greaterThan(0);\r",
                  "    pm.expect(jsonData.depositpaid).to.be.true;\r",
                  "    pm.expect(jsonData.bookingdates.checkin).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);\r",
                  "\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": {
              "raw": "{{baseUrl}}/booking/:bookingId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                ":bookingId"
              ],
              "variable": [
                {
                  "key": "bookingId",
                  "value": "{{bookingId}}"
                }
              ]
            }
          },
          "response": []
